# Environment Variables @ backend/automations/.env

# Notion public page ID (from URL: notion.so/My-Page-<ID>)
NOTION_PAGE_ID=your_page_id_here

# Notion integration token (for pdf-to-notion write access)
# Get from https://www.notion.so/my-integrations
NOTION_TOKEN=ntn_your_token_here

# Notion database ID (for pdf-to-notion to add rows)
NOTION_DATABASE_ID=your_database_id_here

# Spotify app (developer.spotify.com/dashboard). Secret + refresh token are
# private: keep them here and in GitHub Actions secrets only.
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
# Get this once with: uv run python scripts/spotify_auth.py
SPOTIFY_REFRESH_TOKEN=your_refresh_token_here
