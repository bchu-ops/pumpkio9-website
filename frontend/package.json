{
  "name": "pumpkio9-website",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "pdfjs-dist": "6.5.438",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-notion-x": "^8.0.8",
    "react-router-dom": "^7.7.0"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite build && node scripts/serve-build.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "cd .. && eslint --config frontend/eslint.config.mjs frontend/src products/*/web products/shared",
    "format": "node scripts/prettier-allowlist.cjs --write",
    "format:check": "node scripts/prettier-allowlist.cjs --check"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.10",
    "@vitejs/plugin-react": "6.3.0",
    "autoprefixer": "^10.4.21",
    "eslint": "10.15.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "postcss": "^8.5.6",
    "prettier": "3.10.1",
    "tailwindcss": "^4.3.5",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
