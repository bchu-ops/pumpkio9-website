# Copy to frontend/.env.local for local development. .env files are git-ignored.
#
# Everything here is built INTO the public site, so only put public values in
# this file, never secrets. Vite only exposes variables that start with VITE_.

# Spotify app client ID for the "Yours" tab (PKCE login, no secret needed).
# In CI this comes from the repo variable SPOTIFY_CLIENT_ID (see docs/secrets.md).
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id_here
