        "version": 4,
        "type": "bulleted_list",
        "properties": {
          "title": [
            [
              "Built a Python sync job that exchanges a refresh token for recent plays and top tracks and artists from the Spotify Web API and writes a static JSON snapshot during each GitHub Actions deploy, so no secrets ever reach the browser"
            ]
          ]
        },
