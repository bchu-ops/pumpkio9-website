# The repo's ONE env file. Copy to .env (same folder, repo root) and fill in.
#   cp .env.example .env
# .env is git-ignored; only this .env.example (placeholders) is committed.
# What's secret and what goes into GitHub Actions instead: docs/secrets.md.
#
# Who reads this file:
#   backend/automations/scripts/*   Notion + Spotify values
#   frontend (Vite)                 only VITE_* values; they are built into the
#                                   PUBLIC site, so never prefix a secret with VITE_
#   products/speeddemon (Docker)    OpenAI + backend settings

# --- Notion: sync_notion.py, pdf_to_notion -------------------------------
# Integration token: https://www.notion.so/my-integrations  (SECRET)
NOTION_TOKEN=ntn_your_token_here
# Portfolio parent page ID (from the URL: notion.so/My-Page-<ID>)
NOTION_PAGE_ID=your_page_id_here
# Database page IDs (from each database's URL)
NOTION_EXPERIENCES_DB_ID=your_experiences_db_id_here
NOTION_PROJECTS_DB_ID=your_projects_db_id_here
NOTION_PAPERS_DB_ID=your_papers_db_id_here
# Collection IDs (sync_notion.py internal API)
NOTION_EXPERIENCES_COLLECTION_ID=your_experiences_collection_id_here
NOTION_PROJECTS_COLLECTION_ID=your_projects_collection_id_here
NOTION_PAPERS_COLLECTION_ID=your_papers_collection_id_here

# --- Spotify: sync_spotify.py, spotify_auth.py ---------------------------
# App at developer.spotify.com/dashboard. Secret + refresh token are SECRET.
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
# Get once with: cd backend/automations && uv run python scripts/spotify_auth.py
SPOTIFY_REFRESH_TOKEN=your_refresh_token_here

# --- Site (public, built into the site) ----------------------------------
# Spotify client ID for the "Yours" tab (PKCE login, no secret needed)
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id_here

# --- Speed Demon backend (products/speeddemon, Docker) -------------------
OPENAI_API_KEY=your_openai_key_here
PDF_SERVICE_TOKEN=your_service_token_here
ENV=development
DEBUG=True
PORT=8000

# --- Speed Demon optional settings (uncomment when needed) ---

# # --- DATABASE CONFIG (DuckDB/Postgres) ---
# DB_PATH=your_db_path_here.db  # For DuckDB
# DB_USER=admin_user
# DB_PASSWORD=your_password_here
# DB_HOST=your_db_host_here
# DB_PORT=your_db_port_here
# DB_NAME=your_db_name_here

# # --- API KEYS (ELT Extraction) ---
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# EXTERNAL_API_KEY=sk_test_51Mz...


# # fastf1 API doesn't require an API key 🤣🤣🤣
# # but I will use AWS secrets manager in production for other sensitive info
# # so sadly there is nothing here :)

# # --- ML SETTINGS ---
# MODEL_ENV=development  # development, staging, production
# REGULARIZATION_STRENGTH=0.1

# # --- CLOUD STORAGE (AWS/GCP) ---
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=your_secret_here
# S3_BUCKET_NAME=f1-data-lake